# Backend origin (no trailing slash).
# Local: copy to .env — Vite loads it for npm run dev.
#   VITE_API_BASE_URL=http://localhost:5000
# Production (Vercel): set in Project → Settings → Environment Variables,
# then Redeploy. Vite embeds this at build time.
#
# VITE_API_URL is accepted as an alias of VITE_API_BASE_URL.
#
# Examples:
# VITE_API_BASE_URL=http://localhost:5000
# VITE_API_BASE_URL=https://adadoviz-backend.onrender.com
VITE_API_BASE_URL=

# Backend origin (no trailing slash).
# Local: copy to .env — Vite loads it for npm run dev.
#   VITE_API_BASE_URL=http://localhost:5000
# Production (Vercel): set in Project → Settings → Environment Variables,
# then Redeploy. Vite embeds this at build time.
#
# VITE_API_URL is accepted as an alias of VITE_API_BASE_URL.
#
# Examples:
# VITE_API_BASE_URL=http://localhost:5000
# VITE_API_BASE_URL=https://adadoviz-backend.onrender.com
VITE_API_BASE_URL=

# ── İletişim bilgileri (frontend/src/lib/contact.js) ──────────────────────
# İletişim sayfasındaki orbital kanal çarkı ve footer bu değerleri kullanır.
# Tanımlanmazsa kodda yazılı yer tutucular ("000") görünür.
#
# VITE_CONTACT_PHONE=+90 392 000 00 00      # görünen numara; tel: linki bundan üretilir
# VITE_CONTACT_WHATSAPP=+90 533 000 00 00   # boş bırakılırsa VITE_CONTACT_PHONE kullanılır
# VITE_CONTACT_EMAIL=iletisim@adadoviz.com
# VITE_CONTACT_INSTAGRAM=adadoviz           # baştaki @ olmadan

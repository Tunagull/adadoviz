# Backend origin (no trailing slash).
# Local: leave empty (defaults to http://localhost:5000) OR set explicitly.
# Production (Vercel): REQUIRED — set in Project → Settings → Environment Variables,
# then Redeploy. Vite embeds this at build time.
#
# Examples:
# VITE_API_BASE_URL=http://localhost:5000
# VITE_API_BASE_URL=https://your-backend.up.railway.app
# VITE_API_BASE_URL=https://api.adadoviz.tunahangul.com
VITE_API_BASE_URL=

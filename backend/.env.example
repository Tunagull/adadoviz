# Bu dosyayı kopyalayıp .env olarak kaydedin ve gerçek değerleri girin.
# .env asla commit edilmemelidir (bkz. .gitignore).

# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Backend için SERVICE_ROLE key zorunlu (RLS lockdown sonrası publishable/anon
# anahtar institutions=0 döndürüp yanlış "ilk kurulum" seed'ine yol açar).
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_KEY=your-service-role-key
# S-C3: RLS self-check probe'u için anon/publishable anahtar. Verilirse boot'ta
# bu anahtarla institutions okunmayı dener; satır dönerse RLS açık demektir ve
# sunucu başlamayı reddeder (bypass: ALLOW_OPEN_RLS=1).
SUPABASE_ANON_KEY=

# JWT — güçlü, rastgele bir değer üretin, örn:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Super Admin
# SUPERADMIN_INITIAL_PASSWORD yalnızca veritabanında admin YOKSA (ilk kurulum)
# kullanılır. Mevcut şifre boot'ta ezilmez.
# BOŞ BIRAKILIRSA: sunucu rastgele güçlü bir şifre üretir ve boot log'una
# BİR KEZ "[SECURITY] ... geçici superadmin şifresi: ..." satırıyla yazar.
# O şifreyle giriş yapıp panelden hemen değiştirin. Asla "123" gibi zayıf
# bir değer koymayın.
SUPERADMIN_USERNAME=tuna
SUPERADMIN_INITIAL_PASSWORD=

# CORS — virgülle ayrılmış TAM origin listesi. Bilinmeyen origin'ler reddedilir.
# FRONTEND_URL da otomatik allowlist'e eklenir. Wildcard yok: her Vercel/başka
# preview domaini buraya AÇIKÇA eklenmeli (S-M2).
CORS_ORIGINS=https://adadoviz.tunahangul.com,https://www.adadoviz.tunahangul.com
# Yalnızca local debug: CORS_ALLOW_ALL=1

# Partnerlik / şifre sıfırlama e-postası (Gmail App Password gerekli)
GMAIL_USER=tunahan.guul@gmail.com
GMAIL_PASS=your-gmail-app-password
PARTNERSHIP_TO_EMAIL=tunahan.guul@gmail.com

# Şifre sıfırlama linkinin gideceği frontend adresi (Render'da production URL)
FRONTEND_URL=https://adadoviz.tunahangul.com

NODE_ENV=production

# --- Postgres dogrudan baglanti (migration kosucusu) ---------------------
# Supabase > Project Settings > Database > Connection string > URI
# Deploy'da "Transaction pooler" (port 6543) tercih edin.
# DIKKAT: Bu deger SUPABASE_KEY'den FARKLIDIR. SUPABASE_KEY PostgREST icin
# API anahtaridir; migration dogrudan Postgres baglantisi ister.
# Ornek: postgresql://postgres:<PAROLA>@<HOST>:6543/postgres
DATABASE_URL=
# S-M3: Supabase CA sertifikasi (migration TLS dogrulamasi). Verilmezse migrate
# rejectUnauthorized:false'a duser (UYARI loglar).
DATABASE_CA_FILE=

# --- Güvenlik ayarları (audit denetimi 2026-09-06) ----------------------
# S-M4: audit hash zinciri HMAC anahtarı (uzun rastgele değer). Boşsa JWT_SECRET.
AUDIT_HMAC_KEY=
# S-M3: KKTC MB kur kaynağı TLS. CA bundle edin (host'a özel zincir):
KKTC_MB_CA_FILE=
# Son çare (önerilmez, UYARI loglar): KKTC_MB_ALLOW_INSECURE_TLS=1
# S-M3: kur mantık bandı — USD orta kuru son değerden bu orandan fazla saparsa
# bülten reddedilir (varsayılan 0.15 = %15).
RATE_SANITY_BAND=0.15

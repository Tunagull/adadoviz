# Bu dosyayı kopyalayıp .env olarak kaydedin ve gerçek değerleri girin.
# .env asla commit edilmemelidir (bkz. .gitignore).

# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Backend için SERVICE_ROLE key kullanılmalı (yalnızca sunucuda, asla frontend'de).
SUPABASE_KEY=your-service-role-or-publishable-key

# JWT — güçlü, rastgele bir değer üretin, örn:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Super Admin ilk kurulum
# Yalnızca veritabanında hiç superadmin yokken kullanılır (bkz. seedSuperAdminIfNeeded).
# Boş bırakılırsa rastgele güçlü bir şifre üretilip konsola bir kereliğine yazdırılır.
SUPERADMIN_USERNAME=tuna
SUPERADMIN_INITIAL_PASSWORD=

NODE_ENV=production
